    },
    "notice.unsupported.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu format nə aparat, nə də VLC mühərriki tərəfindən oxunur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither the hardware decoder nor the VLC engine can read this format."
          }
        }
      }
    },
    "notice.corrupt.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxunuş dayandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback stopped"
          }
        }
      }
    },
    "notice.corrupt.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylın bu hissəsi yarımçıq görünür — yüklənmə yarıda qalmış ola bilər."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part of the file looks incomplete — the download may have been cut short."
          }
        }
      }
    },
