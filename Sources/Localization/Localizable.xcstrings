    "settings.privacyNote": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar cihazdan çıxmır. Analitika və şəbəkə sorğusu yoxdur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files never leave the device. No analytics, no network calls."
          }
        }
      }
    },
    "notice.software.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Proqram dekodlaşdırma"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software decoding"
          }
        }
      }
    },
    "notice.software.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fayl VLC mühərriki ilə oynayır: PiP işləmir, AirPlay yalnız ekran güzgüsüdür, batareya sürətli boşalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file plays through the VLC engine: no PiP, AirPlay is screen mirroring only, and the battery drains faster."
          }
        }
      }
    },
    "notice.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl tapılmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File not found"
          }
        }
      }
    },
    "notice.missing.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl köçürülüb və ya silinib. Qovluğu yenidən seçsən, yeri bərpa olunacaq."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file was moved or deleted. Pick the folder again to restore it."
          }
        }
      }
    },
    "notice.unsupported.title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
